rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() {
   return request.auth != null
    && request.auth.uid == 'REPLACE_WITH_YOUR_ADMIN_UID'
    && request.auth.token.firebase.sign_in_provider == 'password';
  }
  function validRSVP() {
   return request.resource.data.keys().hasAll(['name','attendance','guests','message','ownerUid','createdAt'])
    && request.resource.data.keys().hasOnly(['name','attendance','guests','message','ownerUid','createdAt'])
    && request.resource.data.name is string
    && request.resource.data.name.size()>0
    && request.resource.data.name.size()<=90
    && request.resource.data.attendance in ['accepted','declined']
    && request.resource.data.guests is int
    && request.resource.data.guests>=0
    && request.resource.data.guests<=30
    && ((request.resource.data.attendance=='accepted' && request.resource.data.guests>=1)
       || (request.resource.data.attendance=='declined' && request.resource.data.guests==0))
    && request.resource.data.message is string
    && request.resource.data.message.size()<=1000
    && request.resource.data.ownerUid==request.auth.uid
    && request.resource.data.createdAt==request.time;
  }
  match /weddingRSVP/{responseId} {
   allow create: if request.auth!=null
    && (admin() || request.auth.token.firebase.sign_in_provider=='anonymous')
    && validRSVP();
   allow read,update,delete: if admin();
  }
 }
}
